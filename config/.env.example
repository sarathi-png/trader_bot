# Quotex Credentials
# The bot uses Playwright to auto-extract your SSID (session token) from qxbroker.com.
# Just provide your email and password -- the bot handles the rest.
# First run opens a Chromium browser window for you to complete login (including Google OAuth).
# After that, the SSID is cached in sessions/session.json and reused until expiry.
#
# To force re-authentication: python run.py --login
# To extract SSID manually:   python -m auth.ssid_extractor

QUOTEX_EMAIL=your_email@example.com
QUOTEX_PASSWORD=your_password
QUOTEX_DEMO=true
# Headless Chromium for `python run.py --login` (servers / scheduled SSID
# refresh). Keep false for the interactive first login on your own machine.
QUOTEX_HEADLESS=false

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_ALLOWED_USERS=123456,789012

# Signal Engine
MIN_CONFIDENCE=50
MIN_PAYOUT=80
MAX_SIGNALS_PER_DAY=15

# Database
DB_PATH=data/signals.db
DB_RETENTION_DAYS=8

# Sessions (SSID cache)
SESSIONS_DIR=sessions

# Session Filters (UTC hours to block)
BLOCKED_HOURS=1,11,17,20

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# --- Host deployment (VM / Docker) ---
# Prefer absolute paths on a server so the bot does not depend on the
# working directory:
# DB_PATH=/opt/quotex-signal-bot/data/signals.db
# LOG_FILE=/opt/quotex-signal-bot/logs/bot.log
# SESSIONS_DIR=/opt/quotex-signal-bot/sessions
#
# Mock cadence in seconds (mock mode only): MOCK_SIGNAL_INTERVAL=60
# News filter (disable to match the verified mock run): NEWS_FILTER_ENABLED=true
#
# Full guide: DEPLOY.md
